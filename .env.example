# Copy to .env for local development (loaded automatically when ENVIRONMENT != production).

# HTTP port
PORT=8080

# SQLite database file (its directory is created automatically)
DB_PATH=./data/inhale.db

# REQUIRED in production. In development a fixed insecure default is used if unset.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me

# Access-token lifetime (Go duration, e.g. 720h = 30 days)
JWT_TTL=720h

# bcrypt cost (10-14 is reasonable; higher = slower + safer)
BCRYPT_COST=12

# Comma-separated CORS origins ("*" allows all). Native iOS ignores CORS.
CORS_ALLOWED_ORIGINS=*

# "development" | "production"
ENVIRONMENT=development
